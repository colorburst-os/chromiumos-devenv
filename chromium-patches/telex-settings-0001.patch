 .../native_input_method_engine_observer.cc    | 53 +++++++++++++++-
 .../native_input_method_engine_observer.h     | 13 ++++
 .../ash/services/ime/rule_based_engine.cc     |  8 ++-
 chromeos/ash/services/ime/unikey_engine.cc    | 60 ++++++++++++-------
 chromeos/ash/services/ime/unikey_engine.h     | 12 +++-
 6 files changed, 144 insertions(+), 30 deletions(-)

diff --git a/chrome/browser/ash/input_method/input_method_settings.cc b/chrome/browser/ash/input_method/input_method_settings.cc
index d23ef32c55..8f136e2947 100644
--- a/chrome/browser/ash/input_method/input_method_settings.cc
+++ b/chrome/browser/ash/input_method/input_method_settings.cc
@@ -68,6 +68,23 @@ bool IsVietnameseVniEngine(std::string_view engine_id) {
   return engine_id == "vkd_vi_vni";
 }
 
+// The rule-based mojo path connects using the normalized "m17n:vi_*" spec
+// (NormalizeRuleBasedEngineId), but Vietnamese settings are matched and stored
+// (by the os-settings UI) under the "vkd_vi_*" engine id. Map the normalized
+// spec back so both the predicate match and the per-input-method pref
+// sub-dictionary lookup succeed. Without this the Telex/VNI settings union was
+// silently never built on the mojo path, so the tone-placement toggle was
+// ignored (colorburst: VIETNAMESE-IME-PERF.md §4.3).
+std::string_view NormalizeVietnameseEngineId(std::string_view engine_id) {
+  if (engine_id == "m17n:vi_telex") {
+    return "vkd_vi_telex";
+  }
+  if (engine_id == "m17n:vi_vni") {
+    return "vkd_vi_vni";
+  }
+  return engine_id;
+}
+
 void RecordSettingsMetrics(const mojom::VietnameseTelexSettings& settings) {
   base::UmaHistogramBoolean(
       "InputMethod.PhysicalKeyboard.VietnameseTelex.FlexibleTyping",
@@ -334,8 +351,13 @@ mojom::InputMethodSettingsPtr CreateSettingsFromPrefs(
   // until the issue is separately addressed outside the scope of the said
   // migration. Thus a single Japanese prefs entry with key "nacl_mozc_jp" is
   // currently used for both "nacl_mozc_jp" and "nacl_mozc_us" input methods.
+  // Accept the normalized "m17n:vi_*" rule-based spec as well as the "vkd_vi_*"
+  // engine id, so Vietnamese settings resolve on both the connect-time and the
+  // per-focus paths (colorburst).
+  std::string_view engine_id_view = NormalizeVietnameseEngineId(engine_id);
+
   std::string_view lookup_engine_id =
-      engine_id == kJapaneseUsEngineId ? kJapaneseEngineId : engine_id;
+      engine_id_view == kJapaneseUsEngineId ? kJapaneseEngineId : engine_id_view;
 
   const base::DictValue* ime_prefs_ptr =
       prefs.GetDict(ash::prefs::kLanguageInputMethodSpecificSettings)
@@ -361,11 +383,11 @@ mojom::InputMethodSettingsPtr CreateSettingsFromPrefs(
     return mojom::InputMethodSettings::NewZhuyinSettings(
         CreateZhuyinSettings(input_method_specific_pref));
   }
-  if (IsVietnameseTelexEngine(engine_id)) {
+  if (IsVietnameseTelexEngine(engine_id_view)) {
     return mojom::InputMethodSettings::NewVietnameseTelexSettings(
         CreateVietnameseTelexSettings(input_method_specific_pref));
   }
-  if (IsVietnameseVniEngine(engine_id)) {
+  if (IsVietnameseVniEngine(engine_id_view)) {
     return mojom::InputMethodSettings::NewVietnameseVniSettings(
         CreateVietnameseVniSettings(input_method_specific_pref));
   }
diff --git a/chrome/browser/ash/input_method/native_input_method_engine_observer.cc b/chrome/browser/ash/input_method/native_input_method_engine_observer.cc
index f8d10d5295..cbbf513994 100644
--- a/chrome/browser/ash/input_method/native_input_method_engine_observer.cc
+++ b/chrome/browser/ash/input_method/native_input_method_engine_observer.cc
@@ -879,7 +879,21 @@ void NativeInputMethodEngineObserver::OnFocus(
   if (grammar_manager_->IsOnDeviceGrammarEnabled()) {
     grammar_manager_->OnFocus(context_id, context.spellcheck_mode);
   }
-  if (ShouldRouteToNativeMojoEngine(engine_id)) {
+  if (ShouldRouteToRuleBasedEngine(engine_id)) {
+    // colorburst: the rule-based mojo engine (UnikeyEngine for Vietnamese) is
+    // what serves physical keys, but the framework routes rule-based focus to
+    // the extension. Keep the extension informed for the virtual-keyboard UI
+    // and mark the text client active exactly as before (rule-based
+    // CommitText/SetComposition depend on it) — deliberately not depending on
+    // the mojo OnFocus reply so no other vkd_* layout can regress. Then, in
+    // addition, hand the mojo engine a fresh per-focus settings snapshot so the
+    // Vietnamese tone-placement toggle (and the other Telex/VNI knobs) apply
+    // live on focus rather than only at connect time. See VIETNAMESE-IME-PERF.md
+    // §4.3.
+    ime_base_observer_->OnFocus(engine_id, context_id, context);
+    OnFocusAck(context_id, true, mojom::InputMethodMetadataPtr(nullptr));
+    DeliverSettingsToRuleBasedEngine(engine_id, context);
+  } else if (ShouldRouteToNativeMojoEngine(engine_id)) {
     if (IsInputMethodBound()) {
       if (assistive_suggester_.get()) {
         assistive_suggester_->FetchEnabledSuggestionsFromBrowserContextThen(
@@ -903,6 +917,30 @@ void NativeInputMethodEngineObserver::OnFocus(
   }
 }
 
+void NativeInputMethodEngineObserver::DeliverSettingsToRuleBasedEngine(
+    const std::string& engine_id,
+    const TextInputMethod::InputContext& context) {
+  if (!IsInputMethodBound() || !prefs_) {
+    return;
+  }
+  // Remember the focused context so a later os-settings toggle can be pushed
+  // live (OnInputMethodOptionsChanged) without waiting for a re-focus.
+  active_rule_based_engine_id_ = engine_id;
+  focused_context_ = context;
+
+  ime::mojom::InputMethodSettingsPtr settings =
+      CreateSettingsFromPrefs(*prefs_, engine_id);
+  const bool is_normal_screen =
+      InputMethodManager::Get()->GetActiveIMEState()->GetUIStyle() ==
+      InputMethodManager::UIStyle::kNormal;
+  mojom::InputFieldInfoPtr input_field_info = CreateInputFieldInfo(
+      engine_id, context, InputFieldContext{}, prefs_, is_normal_screen);
+  // The active-state bookkeeping was already handled by the synchronous
+  // OnFocusAck above; ignore this reply.
+  input_method_->OnFocus(std::move(input_field_info), std::move(settings),
+                         base::DoNothing());
+}
+
 void NativeInputMethodEngineObserver::HandleOnFocusAsyncForNativeMojoEngine(
     const std::string& engine_id,
     int context_id,
@@ -961,6 +999,7 @@ void NativeInputMethodEngineObserver::OnBlur(const std::string& engine_id,
   UpdateCandidatesWindowSync(nullptr);
 
   text_client_ = std::nullopt;
+  focused_context_ = std::nullopt;
 
   if (chromeos::features::IsOrcaEnabled() && editor_event_sink_) {
     editor_event_sink_->OnBlur();
@@ -1259,6 +1298,18 @@ void NativeInputMethodEngineObserver::OnSuggestionsChanged(
 
 void NativeInputMethodEngineObserver::OnInputMethodOptionsChanged(
     const std::string& engine_id) {
+  // colorburst: if a Vietnamese/rule-based field is focused and its options
+  // changed (e.g. the os-settings new-style tone-mark toggle), re-deliver the
+  // settings to the mojo engine now so the change takes effect live, without a
+  // re-focus or IME reconnect. `engine_id` here is the pref sub-dictionary key
+  // that changed (e.g. "vkd_vi_telex"); match it against the focused engine.
+  if (!active_rule_based_engine_id_.empty() && focused_context_.has_value() &&
+      IsInputMethodBound() && text_client_.has_value() &&
+      (engine_id == active_rule_based_engine_id_ ||
+       engine_id == NormalizeRuleBasedEngineId(active_rule_based_engine_id_))) {
+    DeliverSettingsToRuleBasedEngine(active_rule_based_engine_id_,
+                                     *focused_context_);
+  }
   ime_base_observer_->OnInputMethodOptionsChanged(engine_id);
 }
 
