--- a/chrome/browser/ash/input_method/native_input_method_engine_observer.h
+++ b/chrome/browser/ash/input_method/native_input_method_engine_observer.h
@@ -177,6 +177,13 @@ class NativeInputMethodEngineObserver : public InputMethodEngineObserver,
       const TextInputMethod::InputContext& context,
       const AssistiveSuggesterSwitch::EnabledSuggestions& enabled_suggestions);
 
+  // colorburst: hands the mojo rule-based engine (UnikeyEngine for Vietnamese)
+  // a fresh per-focus settings snapshot so os-settings toggles apply live. The
+  // text client's active state is managed by the caller, not this call's reply.
+  void DeliverSettingsToRuleBasedEngine(
+      const std::string& engine_id,
+      const TextInputMethod::InputContext& context);
+
   bool IsInputMethodBound();
   bool IsInputMethodConnected();
   bool IsTextClientActive();
@@ -209,6 +216,12 @@ class NativeInputMethodEngineObserver : public InputMethodEngineObserver,
 
   std::optional<TextClient> text_client_;
 
+  // colorburst: the currently active rule-based engine id (e.g. "vkd_vi_telex")
+  // and the focused field's input context, retained so a settings change can be
+  // re-delivered to the mojo engine live (see OnInputMethodOptionsChanged).
+  std::string active_rule_based_engine_id_;
+  std::optional<TextInputMethod::InputContext> focused_context_;
+
   // |use_ime_service| should always be |true| in prod code, and may only be
   // |false| in browser tests that need to avoid connecting to the Mojo IME
   // service which can involve loading libimedecoder.so unsupported in tests.
diff --git a/chromeos/ash/services/ime/rule_based_engine.cc b/chromeos/ash/services/ime/rule_based_engine.cc
index 05b25ea954..83d7b0bc27 100644
--- a/chromeos/ash/services/ime/rule_based_engine.cc
+++ b/chromeos/ash/services/ime/rule_based_engine.cc
@@ -112,7 +112,13 @@ RuleBasedEngine::~RuleBasedEngine() = default;
 void RuleBasedEngine::OnFocus(mojom::InputFieldInfoPtr input_field_info,
                               mojom::InputMethodSettingsPtr settings,
                               OnFocusCallback callback) {
-  std::move(callback).Run(/*success=*/false,
+  // Rule-based tables have no per-focus settings, but reporting failure here is
+  // wrong: the observer's OnFocusAck uses this to mark the text client active,
+  // which gates CommitText/SetComposition. Report success so a focus delivered
+  // on the mojo rule-based path does not silently disable committing
+  // (colorburst: the Vietnamese UnikeyEngine overrides this and applies its
+  // settings; other vkd_* layouts simply have none to apply).
+  std::move(callback).Run(/*success=*/true,
                           /*metadata=*/mojom::InputMethodMetadataPtr(nullptr));
 }
 
