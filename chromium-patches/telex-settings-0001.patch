-    bool modern_tone_placement)
+    const mojom::InputMethodSettingsPtr& settings)
     : receiver_(this, std::move(receiver)),
       host_(std::move(host)),
       mem_(std::make_unique<UkSharedMem>()),
@@ -147,7 +142,7 @@ UnikeyEngine::UnikeyEngine(
   mem_->usrKeyMapLoaded = false;
   mem_->charsetId = CONV_CHARSET_XUTF8;
   mem_->input.setIM(UkTelex);
-  ApplyOptions(modern_tone_placement);
+  ApplySettings(settings);
 
   engine_->setCtrlInfo(mem_.get());
   engine_->setCheckKbCaseFunc(
@@ -161,15 +156,37 @@ UnikeyEngine::UnikeyEngine(
 
 UnikeyEngine::~UnikeyEngine() = default;
 
-void UnikeyEngine::ApplyOptions(bool modern_tone_placement) {
-  mem_->options.freeMarking = 1;
-  mem_->options.modernStyle = modern_tone_placement ? 1 : 0;
+void UnikeyEngine::ApplySettings(const mojom::InputMethodSettingsPtr& settings) {
+  // Defaults mirror the os-settings pref defaults (see input_method_settings.cc
+  // CreateVietnameseTelexSettings): flexible diacritics on, classic tone
+  // placement, underline shown.
+  bool flexible = true;
+  bool modern = false;
+  bool underline = true;
+  if (settings && settings->is_vietnamese_telex_settings()) {
+    const auto& s = *settings->get_vietnamese_telex_settings();
+    flexible = s.allow_flexible_diacritics;
+    modern = s.new_style_tone_mark_placement;
+    underline = s.show_underline_for_composition_text;
+    // enable_insert_double_horn_on_uo and enable_w_for_u_horn_shortcut are
+    // properties of the Telex input-method definition in UkEngine (processHook
+    // / processTelexW), not runtime UnikeyOptions fields; the vendored engine
+    // applies both unconditionally, matching their default-on prefs.
+  }
+
+  // allow_flexible_diacritics ("free marking"): tone/diacritic keys may be
+  // typed anywhere in the syllable rather than only right after the vowel.
+  mem_->options.freeMarking = flexible ? 1 : 0;
+  // new_style_tone_mark_placement: modern (hoà) vs classic (hòa) — this is D1.
+  mem_->options.modernStyle = modern ? 1 : 0;
   mem_->options.macroEnabled = 0;
   mem_->options.spellCheckEnabled = 1;   // needed for the D4 restore logic
   mem_->options.autoNonVnRestore = 1;    // D4: restore non-Vietnamese words
   mem_->options.strictSpellCheck = 0;
   mem_->options.useUnicodeClipboard = 0;
   mem_->options.alwaysMacro = 0;
+
+  show_underline_ = underline;
 }
 
 bool UnikeyEngine::IsConnected() {
@@ -179,16 +196,13 @@ bool UnikeyEngine::IsConnected() {
 void UnikeyEngine::OnFocus(mojom::InputFieldInfoPtr input_field_info,
                            mojom::InputMethodSettingsPtr settings,
                            OnFocusCallback callback) {
-  // Unlike RuleBasedEngine (which discards settings and reports failure), read
-  // the Telex tone-placement toggle so D1 is actually configurable.
-  bool modern = false;
-  if (settings && settings->is_vietnamese_telex_settings()) {
-    modern = settings->get_vietnamese_telex_settings()
-                 ->new_style_tone_mark_placement;
-  }
-  ApplyOptions(modern);
-  engine_->reset();
-  composition_.clear();
+  // Unlike RuleBasedEngine (which discards settings), read the full Telex
+  // settings union so the os-settings toggles (D1 tone placement, flexible
+  // diacritics, composition underline) apply live on every focus / options
+  // change delivered on the mojo path. Commit any in-flight preedit first so a
+  // mid-word settings change does not strand it.
+  CommitAndReset();
+  ApplySettings(settings);
   std::move(callback).Run(/*success=*/true,
                           /*metadata=*/mojom::InputMethodMetadataPtr(nullptr));
 }
@@ -206,7 +220,9 @@ void UnikeyEngine::UpdateComposition() {
   std::u16string text = CodepointsToU16(composition_);
   std::vector<mojom::CompositionSpanPtr> spans;
   spans.push_back(mojom::CompositionSpan::New(
-      0, text.length(), mojom::CompositionSpanStyle::kNone));
+      0, text.length(),
+      show_underline_ ? mojom::CompositionSpanStyle::kDefault
+                      : mojom::CompositionSpanStyle::kNone));
   const int cursor = text.length();
   host_->SetComposition(std::move(text), std::move(spans), cursor);
 }
