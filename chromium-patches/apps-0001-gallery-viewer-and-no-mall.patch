+function svgIcon(path: string): SVGElement {
+  const svg = document.createElementNS('http://www.w3.org/2000/svg', 'svg');
+  svg.setAttribute('viewBox', '0 0 24 24');
+  const p = document.createElementNS('http://www.w3.org/2000/svg', 'path');
+  p.setAttribute('d', path);
+  svg.appendChild(p);
+  return svg;
+}
+
+/** True for the file types this viewer can actually display. */
+function categoryFor(mimeType: string): 'image'|'video'|'audio'|'pdf'|'other' {
+  const [type, subtype] = mimeType.split('/');
+  if (type === 'image') {
+    return 'image';
+  }
+  if (type === 'video') {
+    return 'video';
+  }
+  if (type === 'audio') {
+    return 'audio';
+  }
+  if (type === 'application' && subtype === 'pdf') {
+    return 'pdf';
+  }
+  return 'other';
+}
 
