+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef CHROME_BROWSER_ASH_LOGIN_SCREENS_LOCAL_ACCOUNT_SCREEN_H_
+#define CHROME_BROWSER_ASH_LOGIN_SCREENS_LOCAL_ACCOUNT_SCREEN_H_
+
+#include <string>
+
+#include "base/functional/callback.h"
+#include "base/memory/weak_ptr.h"
+#include "base/values.h"
+#include "chrome/browser/ash/login/screens/base_screen.h"
+#include "chrome/browser/ash/login/wizard_context.h"
+
+namespace ash {
+
+class LocalAccountScreenView;
+
+// Collects a name for an account that lives only on this device, mints a
+// non-Gaia AccountId from it, and hands it to the ordinary login path.
+//
+// It deliberately does *not* collect a password: a brand new persistent user
+// created through AuthSessionAuthenticator::CompleteLogin has its cryptohome
+// created without a knowledge factor, and the knowledge factor is set up
+// afterwards by upstream's own PasswordSelectionScreen /
+// LocalPasswordSetupScreen. Because a local account has no online password,
+// PasswordSelectionScreen resolves to LOCAL_PASSWORD_FORCED on its own and
+// the user goes straight to "create a password for this device".
+class LocalAccountScreen : public BaseScreen {
+ public:
+  using TView = LocalAccountScreenView;
+
+  enum class Result {
+    // The user backed out; go back to the user creation screen.
+    kBack,
+    kNotApplicable,
+  };
+
+  using ScreenExitCallback = base::RepeatingCallback<void(Result result)>;
+
+  LocalAccountScreen(base::WeakPtr<LocalAccountScreenView> view,
+                     const ScreenExitCallback& exit_callback);
+
+  LocalAccountScreen(const LocalAccountScreen&) = delete;
+  LocalAccountScreen& operator=(const LocalAccountScreen&) = delete;
+
+  ~LocalAccountScreen() override;
+
+  void set_exit_callback_for_testing(const ScreenExitCallback& exit_callback) {
+    exit_callback_ = exit_callback;
+  }
+
+  static std::string GetResultString(Result result);
+
+  // The e-mail realm used for accounts that exist only on this device.
+  // "localhost" is not resolvable and cannot be a real Gaia domain, so an
+  // address in it can never collide with a Google account.
+  static const char kLocalAccountDomain[];
+
+  // Returns the canonical account id string for `name`, or an empty string if
+  // `name` is not a usable account name.
+  static std::string CanonicalizeName(const std::string& name);
+
+ private:
+  // BaseScreen:
+  void ShowImpl() override;
+  void HideImpl() override;
+  void OnUserAction(const base::ListValue& args) override;
+
+  void CreateAccount(const std::string& name);
+
+  base::WeakPtr<LocalAccountScreenView> view_;
+  ScreenExitCallback exit_callback_;
+};
+
+}  // namespace ash
+
+#endif  // CHROME_BROWSER_ASH_LOGIN_SCREENS_LOCAL_ACCOUNT_SCREEN_H_
