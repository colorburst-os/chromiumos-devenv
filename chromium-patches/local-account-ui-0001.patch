+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ui/webui/ash/login/local_account_screen_handler.h"
+
+#include "ash/login/resources/grit/ash_login_strings.h"
+#include "base/values.h"
+#include "chrome/browser/ui/webui/ash/login/base_screen_handler.h"
+#include "components/login/localized_values_builder.h"
+
+namespace ash {
+
+LocalAccountScreenHandler::LocalAccountScreenHandler()
+    : BaseScreenHandler(kScreenId) {}
+
+LocalAccountScreenHandler::~LocalAccountScreenHandler() = default;
+
+void LocalAccountScreenHandler::DeclareLocalizedValues(
+    ::login::LocalizedValuesBuilder* builder) {
+  builder->Add("localAccountTitle", IDS_OOBE_LOCAL_ACCOUNT_TITLE);
+  builder->Add("localAccountSubtitle", IDS_OOBE_LOCAL_ACCOUNT_SUBTITLE);
+  builder->Add("localAccountNameLabel", IDS_OOBE_LOCAL_ACCOUNT_NAME_LABEL);
+  builder->Add("localAccountNameHint", IDS_OOBE_LOCAL_ACCOUNT_NAME_HINT);
+  builder->Add("localAccountNameInvalid", IDS_OOBE_LOCAL_ACCOUNT_NAME_INVALID);
+  builder->Add("localAccountNameTaken", IDS_OOBE_LOCAL_ACCOUNT_NAME_TAKEN);
+}
+
+void LocalAccountScreenHandler::Show() {
+  ShowInWebUI();
+}
+
+void LocalAccountScreenHandler::ShowNameError(const std::string& error_key) {
+  CallExternalAPI("showNameError", error_key);
+}
+
+base::WeakPtr<LocalAccountScreenView> LocalAccountScreenHandler::AsWeakPtr() {
+  return weak_ptr_factory_.GetWeakPtr();
+}
+
+}  // namespace ash
