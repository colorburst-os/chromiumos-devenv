@@ -0,0 +1,142 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/ash/login/screens/local_account_screen.h"
+
+#include <string>
+
+#include "base/logging.h"
+#include "base/memory/weak_ptr.h"
+#include "base/strings/string_util.h"
+#include "base/values.h"
+#include "chrome/browser/ash/login/oobe_screen.h"
+#include "chrome/browser/ash/login/screens/base_screen.h"
+#include "chrome/browser/ash/login/wizard_context.h"
+#include "chrome/browser/ui/ash/login/login_display_host.h"
+#include "chrome/browser/ui/webui/ash/login/local_account_screen_handler.h"
+#include "chromeos/ash/components/login/auth/public/user_context.h"
+#include "components/account_id/account_id.h"
+#include "components/user_manager/user_manager.h"
+#include "components/user_manager/user_type.h"
+#include "google_apis/gaia/gaia_auth_util.h"
+
+namespace ash {
+namespace {
+
+constexpr char kUserActionBack[] = "back";
+constexpr char kUserActionNext[] = "next";
+
+// i18n keys, declared in LocalAccountScreenHandler.
+constexpr char kErrorInvalid[] = "localAccountNameInvalid";
+constexpr char kErrorTaken[] = "localAccountNameTaken";
+
+constexpr size_t kMaxNameLength = 32;
+
+}  // namespace
+
+// static
+const char LocalAccountScreen::kLocalAccountDomain[] = "localhost";
+
+// static
+std::string LocalAccountScreen::GetResultString(Result result) {
+  // LINT.IfChange(UsageMetrics)
+  switch (result) {
+    case Result::kBack:
+      return "Back";
+    case Result::kNotApplicable:
+      return BaseScreen::kNotApplicable;
+  }
+  // LINT.ThenChange(//tools/metrics/histograms/metadata/oobe/histograms.xml)
+}
+
+// static
+std::string LocalAccountScreen::CanonicalizeName(const std::string& name) {
+  const std::string trimmed =
+      base::ToLowerASCII(base::TrimWhitespaceASCII(name, base::TRIM_ALL));
+  if (trimmed.empty() || trimmed.size() > kMaxNameLength) {
+    return std::string();
+  }
+  // The name becomes the local part of an e-mail address and, through
+  // cryptohome, part of a path. Keep it to an unambiguous ASCII subset, and
+  // require it to start with a letter so it can never be confused with an
+  // account-id key ("g-...") or a reserved cryptohome user ("$guest").
+  if (!base::IsAsciiLower(trimmed[0])) {
+    return std::string();
+  }
+  for (char c : trimmed) {
+    if (!base::IsAsciiLower(c) && !base::IsAsciiDigit(c) && c != '.' &&
+        c != '-' && c != '_') {
+      return std::string();
+    }
+  }
+  return trimmed + "@" + kLocalAccountDomain;
+}
+
+LocalAccountScreen::LocalAccountScreen(
+    base::WeakPtr<LocalAccountScreenView> view,
+    const ScreenExitCallback& exit_callback)
+    : BaseScreen(LocalAccountScreenView::kScreenId, OobeScreenPriority::DEFAULT),
+      view_(std::move(view)),
+      exit_callback_(exit_callback) {}
+
+LocalAccountScreen::~LocalAccountScreen() = default;
+
+void LocalAccountScreen::ShowImpl() {
+  if (!view_) {
+    return;
+  }
+  view_->Show();
+}
+
+void LocalAccountScreen::HideImpl() {}
+
+void LocalAccountScreen::OnUserAction(const base::ListValue& args) {
+  const std::string& action_id = args[0].GetString();
+  if (action_id == kUserActionNext) {
+    CreateAccount(args[1].GetString());
+  } else if (action_id == kUserActionBack) {
+    exit_callback_.Run(Result::kBack);
+  } else {
+    BaseScreen::OnUserAction(args);
+  }
+}
+
+void LocalAccountScreen::CreateAccount(const std::string& name) {
+  const std::string user_email = CanonicalizeName(name);
+  if (user_email.empty()) {
+    if (view_) {
+      view_->ShowNameError(kErrorInvalid);
+    }
+    return;
+  }
+  // CanonicalizeName() already produces a canonical address, but AccountId's
+  // constructor DCHECKs against gaia's canonicalizer, so go through it.
+  const std::string canonical = gaia::CanonicalizeEmail(user_email);
+  const AccountId account_id = AccountId::FromLocalUserEmail(canonical);
+
+  auto* user_manager = user_manager::UserManager::Get();
+  if (user_manager && user_manager->FindUser(account_id)) {
+    if (view_) {
+      view_->ShowNameError(kErrorTaken);
+    }
+    return;
+  }
+
+  LOG(WARNING) << "Creating a device-local account for " << account_id;
+
+  UserContext user_context(user_manager::UserType::kRegular, account_id);
+  // Nothing about this account ever talks to Gaia, and there is no online
+  // password: PasswordSelectionScreen will therefore force the local-password
+  // flow, which is what creates the cryptohome knowledge factor.
+  user_context.SetIsUsingOAuth(false);
+  user_context.SetAuthFlow(UserContext::AUTH_FLOW_OFFLINE);
+
+  // Hands over to ExistingUserController, which runs the ordinary
+  // LoginPerformer -> AuthSessionAuthenticator -> cryptohome path. This screen
+  // is torn down with the rest of the sign-in UI when that succeeds, so there
+  // is no exit callback to run here.
+  LoginDisplayHost::default_host()->CompleteLogin(user_context);
+}
+
+}  // namespace ash
