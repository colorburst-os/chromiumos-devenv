+
+#ifndef CHROME_BROWSER_UI_WEBUI_ASH_LOGIN_LOCAL_ACCOUNT_SCREEN_HANDLER_H_
+#define CHROME_BROWSER_UI_WEBUI_ASH_LOGIN_LOCAL_ACCOUNT_SCREEN_HANDLER_H_
+
+#include <string>
+
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/ash/login/oobe_screen.h"
+#include "chrome/browser/ui/webui/ash/login/base_screen_handler.h"
+#include "components/login/localized_values_builder.h"
+
+namespace ash {
+
+// Interface for dependency injection between LocalAccountScreen and its WebUI
+// representation.
+class LocalAccountScreenView {
+ public:
+  // LINT.IfChange(UsageMetrics)
+  inline constexpr static StaticOobeScreenId kScreenId{"local-account",
+                                                       "LocalAccountScreen"};
+  // LINT.ThenChange(//tools/metrics/histograms/metadata/oobe/histograms.xml)
+
+  virtual ~LocalAccountScreenView() = default;
+
+  // Shows the contents of the screen.
+  virtual void Show() = 0;
+
+  // Puts the name field back into an editable state and shows `error`, which
+  // is one of the i18n keys declared by DeclareLocalizedValues().
+  virtual void ShowNameError(const std::string& error_key) = 0;
+
+  virtual base::WeakPtr<LocalAccountScreenView> AsWeakPtr() = 0;
+};
+
+class LocalAccountScreenHandler : public BaseScreenHandler,
+                                  public LocalAccountScreenView {
+ public:
+  using TView = LocalAccountScreenView;
+
+  LocalAccountScreenHandler();
+
+  LocalAccountScreenHandler(const LocalAccountScreenHandler&) = delete;
+  LocalAccountScreenHandler& operator=(const LocalAccountScreenHandler&) =
+      delete;
+
+  ~LocalAccountScreenHandler() override;
+
+  // BaseScreenHandler:
+  void DeclareLocalizedValues(
+      ::login::LocalizedValuesBuilder* builder) override;
+
+  // LocalAccountScreenView:
+  void Show() override;
+  void ShowNameError(const std::string& error_key) override;
+  base::WeakPtr<LocalAccountScreenView> AsWeakPtr() override;
+
+ private:
+  base::WeakPtrFactory<LocalAccountScreenView> weak_ptr_factory_{this};
+};
+
+}  // namespace ash
+
+#endif  // CHROME_BROWSER_UI_WEBUI_ASH_LOGIN_LOCAL_ACCOUNT_SCREEN_HANDLER_H_
