+#include "components/user_manager/user.h"
+#include "components/user_manager/user_manager.h"
 
 namespace ash {
 
@@ -84,6 +86,26 @@ void RecoveryEligibilityScreen::InspectContext(UserContext* user_context) {
 }
 
 void RecoveryEligibilityScreen::ProcessOptions() {
+  // colorburst: cryptohome recovery wraps the recovery secret against a
+  // Google-hosted service and is redeemed by reauthenticating with Gaia. A
+  // device-local account has no Gaia identity, so the factor simply cannot be
+  // configured -- RecoveryFactorEditor fails with code 50 and
+  // CryptohomeRecoverySetupScreen dead-ends on its error page, stranding the
+  // user in OOBE before the password is ever set.
+  //
+  // Note the user is opted in here by default and only *asked* later, on
+  // ConsolidatedConsentScreen, which does not run for a Gaia-less user. So
+  // without this the opt-in is both unconsented and unfulfillable.
+  const user_manager::User* active_user =
+      user_manager::UserManager::Get()->GetActiveUser();
+  if (!active_user || !active_user->HasGaiaAccount()) {
+    context()->recovery_setup.is_supported = false;
+    context()->recovery_setup.ask_about_recovery_consent = false;
+    context()->recovery_setup.recovery_factor_opted_in = false;
+    exit_callback_.Run(Result::PROCEED);
+    return;
+  }
+
   if (recovery_supported_) {
     context()->recovery_setup.is_supported = true;
     // Don't ask about recovery consent for managed users - use the policy value
