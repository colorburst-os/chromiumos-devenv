 #include "components/user_manager/user_manager.h"
 
 namespace session_manager {
@@ -220,8 +221,16 @@ void SessionManager::CreateSessionInternal(const AccountId& user_account_id,
   // TODO(crbug.com/278643115): This attribute looks like the one for Session
   // rather than UserManager. Move the field.
   // Note: For KioskApp user, this may be updated later in UserSessionManager.
+  // colorburst: ask the *type* whether this is the kind of user that has an
+  // onboarding flow, not whether this particular account happens to be backed
+  // by Gaia. The intent here is to exclude guest/kiosk sessions, which are not
+  // "new users" in the onboarding sense; a device-local account is a regular
+  // consumer user and must go through onboarding, because that is where
+  // PasswordSelectionScreen / LocalPasswordSetupScreen create its cryptohome
+  // knowledge factor. Without this it lands on the desktop with no password
+  // and no auth factor at all.
   user_manager_->SetIsCurrentUserNew(
-      (new_user && user.HasGaiaAccount()) ||
+      (new_user && user_manager::User::TypeHasGaiaAccount(user.GetType())) ||
       user.GetType() == user_manager::UserType::kPublicAccount);
 
   observers_.Notify(&SessionManagerObserver::OnSessionCreationStarted,
