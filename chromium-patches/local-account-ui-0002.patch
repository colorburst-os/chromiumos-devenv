 .../login/screens/common/user_creation.ts     |  7 +++++-
 .../session_manager/core/session_manager.cc   | 11 +++++++++-
 components/user_manager/known_user.cc         | 19 ++++++++++++++++
 6 files changed, 69 insertions(+), 4 deletions(-)

diff --git a/chrome/browser/ash/login/screens/local_account_screen.cc b/chrome/browser/ash/login/screens/local_account_screen.cc
index d2ab66172d..1af2870e16 100644
--- a/chrome/browser/ash/login/screens/local_account_screen.cc
+++ b/chrome/browser/ash/login/screens/local_account_screen.cc
@@ -94,6 +94,11 @@ void LocalAccountScreen::HideImpl() {}
 void LocalAccountScreen::OnUserAction(const base::ListValue& args) {
   const std::string& action_id = args[0].GetString();
   if (action_id == kUserActionNext) {
+    // The renderer is not trusted to send well-formed arguments.
+    if (args.size() < 2 || !args[1].is_string()) {
+      LOG(ERROR) << "local-account: malformed 'next' action";
+      return;
+    }
     CreateAccount(args[1].GetString());
   } else if (action_id == kUserActionBack) {
     exit_callback_.Run(Result::kBack);
@@ -136,7 +141,12 @@ void LocalAccountScreen::CreateAccount(const std::string& name) {
   // LoginPerformer -> AuthSessionAuthenticator -> cryptohome path. This screen
   // is torn down with the rest of the sign-in UI when that succeeds, so there
   // is no exit callback to run here.
-  LoginDisplayHost::default_host()->CompleteLogin(user_context);
+  auto* host = LoginDisplayHost::default_host();
+  if (!host) {
+    LOG(ERROR) << "local-account: no LoginDisplayHost";
+    return;
+  }
+  host->CompleteLogin(user_context);
 }
 
 }  // namespace ash
