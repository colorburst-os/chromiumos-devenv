From 2e11f1235c62f84bf7dd354227b0779e2d34346e Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?L=C6=B0u=20Oa=20Oa?=
 <212658678+luuoaoa@users.noreply.github.com>
Date: Fri, 28 Aug 2026 00:09:47 -0700
Subject: [PATCH] Branding: call the browser "Browser" and show colorburst's
 own version

The About page reported Chrome's version, which says nothing about the build
a user is running; it now reports CHROMEOS_RELEASE_VERSION and keeps the
Chromium version in the modifier slot. The launcher entry, the browser's About
menu item and the Settings About title name the browser or colorburst instead
of Chromium and ChromiumOS, with Vietnamese translations.
---
 chrome/app/chromium_strings.grd               |  4 ++--
 chrome/app/generated_resources.grd            |  3 +++
 chrome/app/resources/chromium_strings_vi.xtb  |  3 +++
 chrome/app/settings_chromium_strings.grdp     |  4 ++--
 chrome/browser/extensions/component_loader.cc |  3 ++-
 .../ash/settings/pages/about/about_section.cc | 24 +++++++++++++++++--
 6 files changed, 34 insertions(+), 7 deletions(-)

diff --git a/chrome/app/chromium_strings.grd b/chrome/app/chromium_strings.grd
index 97a2e8c7ef..2d44089c8c 100644
--- a/chrome/app/chromium_strings.grd
+++ b/chrome/app/chromium_strings.grd
@@ -1116,10 +1116,10 @@ Chromium is unable to recover your settings.
       </if>
       <if expr="is_chromeos">
         <message name="IDS_ABOUT" desc="The text label of the About Chrome menu item">
-          About &amp;Chromium
+          About &amp;Browser
         </message>
         <message name="IDS_RELAUNCH_TO_UPDATE" desc="The text label of the relaunch to update ChromeOS menu item">
-          Relaunch to update &amp;ChromiumOS
+          Relaunch to update &amp;colorburst
         </message>
       </if>
 
diff --git a/chrome/app/generated_resources.grd b/chrome/app/generated_resources.grd
index 74e2603f0e..b1191f69d3 100644
--- a/chrome/app/generated_resources.grd
+++ b/chrome/app/generated_resources.grd
@@ -4977,6 +4977,9 @@ are declared in tools/grit/grit_args.gni.
       <message name="IDS_TASK_MANAGER_WEB_BROWSER_CELL_TEXT" desc="The text of the web browser process row">
         Browser
       </message>
+      <message name="IDS_BROWSER_APP_NAME" desc="Name of the browser as it appears in the launcher and the shelf">
+        Browser
+      </message>
       <message name="IDS_TASK_MANAGER_EXTENSION_PREFIX" desc="The prefix for a Task Manager extension row (always visible if the extension has a view)">
         Extension: <ph name="EXTENSION_NAME">$1<ex>Sample Extension</ex></ph>
       </message>
diff --git a/chrome/app/resources/chromium_strings_vi.xtb b/chrome/app/resources/chromium_strings_vi.xtb
index a2d883d6a9..f52c5d97c2 100644
--- a/chrome/app/resources/chromium_strings_vi.xtb
+++ b/chrome/app/resources/chromium_strings_vi.xtb
@@ -326,6 +326,7 @@
 <translation id="4536805923587466102">Bạn đã đăng nhập bằng <ph name="USER_EMAIL_ADDRESS" /> trong một hồ sơ Chromium khác</translation>
 <translation id="4548534452171747496">Chromium tải trước các trang để giúp bạn duyệt web và tìm kiếm nhanh hơn. <ph name="BEGIN_LINK" />Tìm hiểu thêm về tính năng tải trước trang<ph name="END_LINK" /></translation>
 <translation id="4549180975214802957">Cải thiện mức độ an toàn trên mạng cho mọi người khi bạn báo cáo một trang web mà bạn cho là có hại.</translation>
+<translation id="455299905984764371">Giới thiệu về colorburst</translation>
 <translation id="4570813286784708942">Chromium đã chặn tệp tải xuống này do không thể xác minh tệp (vì bạn đã tắt tính năng Duyệt web an toàn)</translation>
 <translation id="4583692638088316420">Dùng thử Google Ống kính với Chromium trên điện thoại</translation>
 <translation id="4594305310729380060">Vào Trình quản lý mật khẩu trên thiết bị này</translation>
@@ -423,6 +424,7 @@ Nếu trang này không hoạt động như mong đợi, hãy thử cho phép t
 <translation id="5809516625706423866">Không thể kết nối với Internet. HTTP 401 không được phép. Vui lòng kiểm tra cấu hình proxy.</translation>
 <translation id="5817952762723416573">Tăng tốc độ tải trang web bằng công cụ V8 của Chromium nhưng làm giảm khả năng chống lại các cuộc tấn công của Chromium. Chế độ cài đặt này đang tắt.</translation>
 <translation id="5821520528363214608">Để sử dụng và lưu dữ liệu Chromium trong Tài khoản Google, hãy cập nhật Chromium</translation>
+<translation id="5821934787310246172">Chạy lại để cập nhật &amp;colorburst</translation>
 <translation id="5824893331272123205">Không tải được bảng điều khiển này, hãy thử lại</translation>
 <translation id="5862307444128926510">Chào mừng bạn đến với Chromium</translation>
 <translation id="5867606647614813312">Bật các tính năng bổ sung để sử dụng các biện pháp bảo vệ mạnh nhất của Chromium</translation>
@@ -457,6 +459,7 @@ Nếu trang này không hoạt động như mong đợi, hãy thử cho phép t
 <translation id="6145820983052037069">Bạn có thể chuyển đổi giữa các hồ sơ trên Chromium tại đây</translation>
 <translation id="615103374448673771">Nếu bạn cho phép cookie thì Chromium có thể dùng các cookie này khi tải trước</translation>
 <translation id="6165508094623778733">Tìm hiểu thêm</translation>
+<translation id="6165720105278553476">Giới thiệu về &amp;Trình duyệt</translation>
 <translation id="6173308241973263798">Xoá dữ liệu Chromium trong tài khoản của bạn</translation>
 <translation id="6174920971222007286">Tệp này có thể nguy hiểm<ph name="LINE_BREAK" />Chromium có thể giúp bạn kiểm tra nội dung tải xuống này nếu bạn cung cấp mật khẩu. Thông tin về tệp sẽ được gửi tới dịch vụ Duyệt web An toàn của Google nhưng nội dung tệp và mật khẩu vẫn nằm trên thiết bị của bạn.</translation>
 <translation id="6182736845697986886">Không cài đặt được do lỗi nội bộ của máy chủ cập nhật.</translation>
diff --git a/chrome/app/settings_chromium_strings.grdp b/chrome/app/settings_chromium_strings.grdp
index 564f6364dd..8f72c4b926 100644
--- a/chrome/app/settings_chromium_strings.grdp
+++ b/chrome/app/settings_chromium_strings.grdp
@@ -41,8 +41,8 @@
     </message>
   </if>
   <if expr="is_chromeos">
-    <message name="IDS_SETTINGS_ABOUT_OS" desc="Menu title for the About ChromiumOS page.">
-      About ChromiumOS
+    <message name="IDS_SETTINGS_ABOUT_OS" desc="Menu title for the About colorburst page.">
+      About colorburst
     </message>
     <message name="IDS_OS_SETTINGS_TAG_OS_VERSION" desc="Text for search result item which, when clicked, navigates the user to about ChromeOS settings, which gives information about the current ChromeOS version.">
       ChromiumOS version
diff --git a/chrome/browser/extensions/component_loader.cc b/chrome/browser/extensions/component_loader.cc
index e926dac169..cd0bf78483 100644
--- a/chrome/browser/extensions/component_loader.cc
+++ b/chrome/browser/extensions/component_loader.cc
@@ -466,7 +466,8 @@ void ComponentLoader::AddWebStoreApp() {
 void ComponentLoader::AddChromeApp() {
   AddWithNameAndDescription(
       IDR_CHROME_APP_MANIFEST, base::FilePath(FILE_PATH_LITERAL("chrome_app")),
-      l10n_util::GetStringUTF8(IDS_SHORT_PRODUCT_NAME),
+      // The launcher entry says what the app is, not what the OS is called.
+      l10n_util::GetStringUTF8(IDS_BROWSER_APP_NAME),
       l10n_util::GetStringUTF8(IDS_CHROME_SHORTCUT_DESCRIPTION));
 }
 
diff --git a/chrome/browser/ui/webui/ash/settings/pages/about/about_section.cc b/chrome/browser/ui/webui/ash/settings/pages/about/about_section.cc
index 5f011a1f6b..acbf181d6e 100644
--- a/chrome/browser/ui/webui/ash/settings/pages/about/about_section.cc
+++ b/chrome/browser/ui/webui/ash/settings/pages/about/about_section.cc
@@ -20,6 +20,7 @@
 #include "base/i18n/message_formatter.h"
 #include "base/no_destructor.h"
 #include "base/strings/string_split.h"
+#include "base/strings/strcat.h"
 #include "base/strings/utf_string_conversions.h"
 #include "base/system/sys_info.h"
 #include "chrome/browser/ash/arc/arc_util.h"
@@ -42,6 +43,7 @@
 #include "components/signin/public/identity_manager/tribool.h"
 #include "components/strings/grit/components_branded_strings.h"
 #include "components/strings/grit/components_strings.h"
+#include "components/version_info/version_info.h"
 #include "components/webui/version/version_ui_constants.h"
 #include "content/public/browser/web_ui_data_source.h"
 #include "ui/base/l10n/l10n_util.h"
@@ -391,8 +393,26 @@ void AboutSection::AddLoadTimeData(content::WebUIDataSource* html_source) {
                             ShouldShowAUToggle(user_manager->GetActiveUser()));
   }
 
-  html_source->AddString("aboutBrowserVersion",
-                         VersionUI::GetAnnotatedVersionStringForUi());
+  // colorburst has its own release version; Chrome's means nothing to a user
+  // here. CHROMEOS_RELEASE_VERSION carries it, and the Chromium version goes in
+  // the modifier slot so a support request still has both.
+  std::string os_version;
+  if (!base::SysInfo::GetLsbReleaseValue("CHROMEOS_RELEASE_VERSION",
+                                         &os_version) ||
+      os_version.empty()) {
+    os_version = std::string(version_info::GetVersionNumber());
+  }
+  html_source->AddString(
+      "aboutBrowserVersion",
+      l10n_util::GetStringFUTF16(
+          IDS_SETTINGS_ABOUT_PAGE_BROWSER_VERSION,
+          base::UTF8ToUTF16(os_version), std::u16string(),
+          l10n_util::GetStringUTF16(version_info::IsOfficialBuild()
+                                        ? IDS_VERSION_UI_OFFICIAL
+                                        : IDS_VERSION_UI_UNOFFICIAL),
+          base::UTF8ToUTF16(base::StrCat(
+              {"Chromium ", version_info::GetVersionNumber()})),
+          l10n_util::GetStringUTF16(VersionUI::VersionProcessorVariation())));
   html_source->AddString(
       "aboutProductCopyright",
       base::i18n::MessageFormatter::FormatWithNumberedArgs(
-- 
