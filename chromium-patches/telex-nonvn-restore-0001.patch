--- a/chrome/app/os_settings_strings.grdp
+++ b/chrome/app/os_settings_strings.grdp
@@ -922,6 +922,12 @@
   <message name="IDS_SETTINGS_INPUT_METHOD_OPTIONS_VIETNAMESE_TELEX_W_SHORTCUT" desc="This is a label for the settings option to enable a shortcut way of typing in the Vietnamese Telex input method whereby typing the key W gives the character Ư directly, without having to type the canonical U-W. Note that the character is U-with-horn.">
    Type "w" to get "ư"
   </message>
+  <message name="IDS_SETTINGS_INPUT_METHOD_OPTIONS_VIETNAMESE_RESTORE_NON_VIETNAMESE" desc="This is a label for the settings option that makes the Vietnamese input method leave non-Vietnamese words alone: when the typed word is not valid Vietnamese, the original keystrokes are kept instead of turning them into accented letters. For example, typing the English word 'worldcup' stays 'worldcup' rather than becoming an accented form.">
+   Restore non-Vietnamese words
+  </message>
+  <message name="IDS_SETTINGS_INPUT_METHOD_OPTIONS_DESCRIPTION_VIETNAMESE_RESTORE_NON_VIETNAMESE" desc="This is a description for the settings option that makes the Vietnamese input method leave non-Vietnamese words alone. It explains that words which are not valid Vietnamese keep their original keystrokes, giving an English word as an example.">
+   Keep the original keys for words that aren't valid Vietnamese (e.g. "worldcup")
+  </message>
 
