--- a/chromeos/ash/services/ime/unikey_engine.cc
+++ b/chromeos/ash/services/ime/unikey_engine.cc
@@ -164,12 +164,14 @@ void UnikeyEngine::ApplySettings(const mojom::InputMethodSettingsPtr& settings)
   bool modern = false;
   bool underline = true;
   bool w_for_u_horn = false;  // default off — bare 'w' stays a literal 'w'
+  bool restore_non_vn = true;  // default on — invalid VN words keep their keys
   if (settings && settings->is_vietnamese_telex_settings()) {
     const auto& s = *settings->get_vietnamese_telex_settings();
     flexible = s.allow_flexible_diacritics;
     modern = s.new_style_tone_mark_placement;
     underline = s.show_underline_for_composition_text;
     w_for_u_horn = s.enable_w_for_u_horn_shortcut;
+    restore_non_vn = s.enable_restore_non_vietnamese_words;
     // enable_insert_double_horn_on_uo is a property of the Telex definition in
     // UkEngine (processHook) and is applied unconditionally.
   }
@@ -184,8 +186,13 @@ void UnikeyEngine::ApplySettings(const mojom::InputMethodSettingsPtr& settings)
   // uw/aw/ow are unaffected either way (they hook a real vowel). Default off.
   mem_->options.bareWToUHorn = w_for_u_horn ? 1 : 0;
   mem_->options.macroEnabled = 0;
-  mem_->options.spellCheckEnabled = 1;   // needed for the D4 restore logic
-  mem_->options.autoNonVnRestore = 1;    // D4: restore non-Vietnamese words
+  // enable_restore_non_vietnamese_words: when a typed word is not valid
+  // Vietnamese, restore the original keystrokes instead of applying diacritics
+  // (e.g. "worldcup" stays "worldcup"). Both fields gate the D4 restore logic:
+  // spellCheckEnabled detects the invalid word, autoNonVnRestore performs the
+  // key restore (UkEngine::processAppend / lastWordIsNonVn). Default on.
+  mem_->options.spellCheckEnabled = restore_non_vn ? 1 : 0;
+  mem_->options.autoNonVnRestore = restore_non_vn ? 1 : 0;
   mem_->options.strictSpellCheck = 0;
   mem_->options.useUnicodeClipboard = 0;
   mem_->options.alwaysMacro = 0;
