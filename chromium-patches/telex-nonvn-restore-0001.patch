@@ -133,6 +139,12 @@ mojom::VietnameseVniSettingsPtr CreateVietnameseVniSettings(
   settings->show_underline_for_composition_text =
       input_method_specific_pref.FindBool(kVnPrefVniShowUnderline)
           .value_or(true);
+  // colorburst: default ON so mixed English/Vietnamese typing "just works"
+  // (invalid Vietnamese words keep their original keystrokes). Carried for
+  // parity with Telex; VNI is rule-based and does not honor it at runtime.
+  settings->enable_restore_non_vietnamese_words =
+      input_method_specific_pref.FindBool(kVnPrefVniEnableNonVnRestore)
+          .value_or(true);
   RecordSettingsMetrics(*settings);
   return settings;
 }
@@ -158,6 +170,14 @@ mojom::VietnameseTelexSettingsPtr CreateVietnameseTelexSettings(
   settings->show_underline_for_composition_text =
       input_method_specific_pref.FindBool(kVnPrefTelexShowUnderline)
           .value_or(true);
+  // colorburst: default ON so mixed English/Vietnamese typing "just works":
+  // when a typed word is not valid Vietnamese, the engine restores the original
+  // keystrokes instead of applying diacritics (e.g. "worldcup" stays
+  // "worldcup"). The engine honors this via UnikeyOptions.spellCheckEnabled +
+  // autoNonVnRestore.
+  settings->enable_restore_non_vietnamese_words =
+      input_method_specific_pref.FindBool(kVnPrefTelexEnableNonVnRestore)
+          .value_or(true);
   RecordSettingsMetrics(*settings);
   return settings;
 }
