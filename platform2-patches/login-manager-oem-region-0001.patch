+// NOTE(colorburst fork): see kColorburstVariantPath above for what this file is
+// and why it lives on the OEM partition. Defined out here, and declared in the
+// header, so chrome_setup_test.cc can point it at a temp file -- the real path
+// is absolute and a unit test cannot write to it.
+std::string GetColorburstRegion(const base::FilePath& variant_path) {
+  std::string contents;
+  if (!base::ReadFileToStringWithMaxSize(variant_path, &contents,
+                                         kColorburstVariantMaxSize)) {
+    return kColorburstDefaultRegion;
+  }
+  for (std::string_view line :
+       base::SplitStringPiece(contents, "\n", base::TRIM_WHITESPACE,
+                              base::SPLIT_WANT_NONEMPTY)) {
+    if (base::StartsWith(line, "#") ||
+        !base::StartsWith(line, kColorburstRegionKey)) {
+      continue;
+    }
+    const std::string_view region =
+        line.substr(std::string_view(kColorburstRegionKey).size());
+    if (region.empty() || region.size() > kColorburstRegionMaxLen ||
+        region.find_first_not_of(kColorburstRegionChars) !=
+            std::string_view::npos) {
+      LOG(WARNING) << "colorburst: ignoring malformed region in "
+                   << variant_path;
+      return kColorburstDefaultRegion;
+    }
+    return std::string(region);
+  }
+  return kColorburstDefaultRegion;
+}
