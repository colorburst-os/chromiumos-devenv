+// NOTE(colorburst fork): the image is region-neutral; the region is DATA, and
+// it lives on the OEM partition (#8, mounted read-only at /usr/share/oem).
+//
+// One build produces every USB variant. A variant is made by writing this one
+// file into the OEM partition of an already-built image -- no rebuild, no
+// re-sign, since that partition carries neither verity nor a signature. The
+// point of choosing partition 8 over anything else is that it is the only
+// place that survives all three of:
+//
+//   * install   -- chromeos-install copies it USB -> disk (chromeos-install.sh,
+//                  copy_partition "${PARTITION_NUM_OEM}")
+//   * OTA       -- update payloads carry KERN + ROOT only
+//   * powerwash -- clobber_state wipes STATE (#1)
+//
+// so a device keeps the personality of the stick it was installed from, for
+// good, and one OTA stream serves every variant.
+//
+// Format is key=value, one per line, '#' comments allowed:
+//
+//   region=vn
+//
+// Chrome turns the region into the OOBE language, the keyboard list and the
+// timezone via /usr/share/misc/cros-regions.json. An absent, unreadable or
+// malformed file means kColorburstDefaultRegion -- English, which is also what
+// a plain unrepacked image gives you.
+constexpr char kColorburstVariantPath[] = "/usr/share/oem/colorburst/variant";
+constexpr char kColorburstDefaultRegion[] = "us";
+constexpr char kColorburstRegionKey[] = "region=";
+// Region codes in cros-regions.json are lowercase and may carry '.' or '-'
+// ("us", "vn", "nordic", "latam-es-419"). Anything else does not name a region,
+// and this string goes onto Chrome's command line, so it is validated rather
+// than trusted: the OEM partition is writable by anyone holding the disk.
+constexpr char kColorburstRegionChars[] =
+    "abcdefghijklmnopqrstuvwxyz0123456789.-";
+constexpr size_t kColorburstRegionMaxLen = 32;
+// The real file is three short lines. The cap only bounds how much of a
+// corrupted 16 MiB partition gets read into memory before it is rejected.
+constexpr size_t kColorburstVariantMaxSize = 4096;
+
+// Passes the OEM partition's region to Chrome. This is add-always rather than
+// add-if-absent on purpose: it must beat the compiled-in fallback in
+// ChromeMainDelegate (chrome_main_delegate.cc), which is add-if-absent. It runs
+// before ApplyUserConfig(), so chrome_dev.conf can still override it on a
+// developer image.
+void AddColorburstRegionFlag(ChromiumCommandBuilder* builder) {
+  const std::string region =
+      GetColorburstRegion(base::FilePath(kColorburstVariantPath));
+  LOG(INFO) << "colorburst: region " << region;
+  builder->AddArg(base::StringPrintf("--cros-region=%s", region.c_str()));
+}
