diff --git a/login_manager/colorburst_config.cc b/login_manager/colorburst_config.cc
new file mode 100644
index 0000000000..bf79173034
--- /dev/null
+++ b/login_manager/colorburst_config.cc
@@ -0,0 +1,152 @@
+// Copyright 2026 The ChromiumOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "login_manager/colorburst_config.h"
+
+#include <string>
+#include <string_view>
+#include <utility>
+#include <vector>
+
+#include <base/files/file_util.h>
+#include <base/logging.h>
+#include <base/strings/string_split.h>
+#include <base/strings/string_util.h>
+
+namespace login_manager {
+
+const char ColorburstConfig::kDefaultPath[] = "/usr/share/oem/colorburst.txt";
+const size_t ColorburstConfig::kMaxFileSize = 64 * 1024;
+
+namespace {
+
+// Region codes and every other identifier the config deals in.
+constexpr char kTokenChars[] = "abcdefghijklmnopqrstuvwxyz0123456789.-";
+constexpr size_t kTokenMaxLen = 32;
+
+constexpr char kDefaultRegion[] = "us";
+constexpr char kRegionKey[] = "region";
+
+// Notepad writes this at the front of a UTF-8 file. Without stripping it the
+// first key silently becomes "\xEF\xBB\xBFregion" and the whole file looks like
+// it did not take.
+constexpr std::string_view kUtf8Bom = "\xEF\xBB\xBF";
+
+// Trims whitespace, then one matching pair of single or double quotes, then
+// whitespace again. region = "vn" is a reasonable thing for a person to type.
+std::string_view Unquote(std::string_view value) {
+  value = base::TrimWhitespaceASCII(value, base::TRIM_ALL);
+  if (value.size() >= 2 && (value.front() == '"' || value.front() == '\'') &&
+      value.back() == value.front()) {
+    value = base::TrimWhitespaceASCII(value.substr(1, value.size() - 2),
+                                      base::TRIM_ALL);
+  }
+  return value;
+}
+
+}  // namespace
+
+ColorburstConfig::ColorburstConfig() = default;
+ColorburstConfig::ColorburstConfig(const ColorburstConfig&) = default;
+ColorburstConfig& ColorburstConfig::operator=(const ColorburstConfig&) =
+    default;
+ColorburstConfig::~ColorburstConfig() = default;
+
+// static
+ColorburstConfig ColorburstConfig::Load(const base::FilePath& path) {
+  std::string contents;
+  if (!base::ReadFileToStringWithMaxSize(path, &contents, kMaxFileSize)) {
+    // Overwhelmingly the normal case: a plain image has an empty OEM
+    // partition. Not worth a warning.
+    VLOG(1) << "colorburst: no configuration at " << path;
+    return ColorburstConfig();
+  }
+  ColorburstConfig config = ParseForTesting(contents);
+  LOG(INFO) << "colorburst: read " << config.size() << " setting(s) from "
+            << path;
+  return config;
+}
+
+// static
+ColorburstConfig ColorburstConfig::ParseForTesting(std::string_view contents) {
+  ColorburstConfig config;
+
+  if (contents.substr(0, kUtf8Bom.size()) == kUtf8Bom) {
+    contents = contents.substr(kUtf8Bom.size());
+  }
+
+  // Splitting on '\n' and trimming leaves CRLF handled: TRIM_ALL eats the '\r'.
+  for (std::string_view line : base::SplitStringPiece(
+           contents, "\n", base::TRIM_WHITESPACE, base::SPLIT_WANT_NONEMPTY)) {
+    if (line.front() == '#' || line.front() == ';') {
+      continue;
+    }
+    const size_t eq = line.find('=');
+    if (eq == std::string_view::npos) {
+      LOG(WARNING) << "colorburst: ignoring line with no '=': " << line;
+      continue;
+    }
+    const std::string key = base::ToLowerASCII(
+        base::TrimWhitespaceASCII(line.substr(0, eq), base::TRIM_ALL));
+    if (key.empty()) {
+      LOG(WARNING) << "colorburst: ignoring line with an empty key";
+      continue;
+    }
+    // First occurrence wins, so a value appended to a file that already sets it
+    // cannot silently override what is already there.
+    config.values_.emplace(key, std::string(Unquote(line.substr(eq + 1))));
+  }
+  return config;
+}
+
+std::optional<std::string> ColorburstConfig::GetRaw(
+    std::string_view key) const {
+  const auto it = values_.find(base::ToLowerASCII(key));
+  if (it == values_.end()) {
+    return std::nullopt;
+  }
+  return it->second;
+}
+
+std::string ColorburstConfig::GetToken(std::string_view key,
+                                       std::string_view default_value) const {
+  const std::optional<std::string> raw = GetRaw(key);
+  if (!raw.has_value()) {
+    return std::string(default_value);
+  }
+  // Lowercased before validation, so REGION=VN works, but nothing outside the
+  // token alphabet survives -- these strings reach Chrome's command line, and
+  // the OEM partition is writable by anyone holding the disk.
+  const std::string value = base::ToLowerASCII(*raw);
+  if (value.empty() || value.size() > kTokenMaxLen ||
+      value.find_first_not_of(kTokenChars) != std::string::npos) {
+    LOG(WARNING) << "colorburst: '" << key << "' is not a valid name; using '"
+                 << default_value << "'";
+    return std::string(default_value);
+  }
+  return value;
+}
+
+bool ColorburstConfig::GetBool(std::string_view key, bool default_value) const {
+  const std::optional<std::string> raw = GetRaw(key);
+  if (!raw.has_value()) {
+    return default_value;
+  }
+  const std::string value = base::ToLowerASCII(*raw);
+  if (value == "true" || value == "yes" || value == "on" || value == "1") {
+    return true;
+  }
+  if (value == "false" || value == "no" || value == "off" || value == "0") {
+    return false;
+  }
+  LOG(WARNING) << "colorburst: '" << key << "' is not yes/no; using "
+               << (default_value ? "yes" : "no");
+  return default_value;
+}
+
+std::string ColorburstConfig::GetRegion() const {
+  return GetToken(kRegionKey, kDefaultRegion);
+}
+
+}  // namespace login_manager
diff --git a/login_manager/colorburst_config.h b/login_manager/colorburst_config.h
new file mode 100644
index 0000000000..8a2d137e87
--- /dev/null
+++ b/login_manager/colorburst_config.h
@@ -0,0 +1,111 @@
+// Copyright 2026 The ChromiumOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef LOGIN_MANAGER_COLORBURST_CONFIG_H_
+#define LOGIN_MANAGER_COLORBURST_CONFIG_H_
+
+#include <map>
+#include <optional>
+#include <string>
+#include <string_view>
+
+#include <base/files/file_path.h>
+
+namespace login_manager {
+
+// NOTE(colorburst fork): the colorburst variant configuration -- one plain-text
+// file on the OEM partition that says how this particular device should behave.
+//
+// It is what makes one build serve every variant. The OEM partition (#8) is the
+// only one that survives all three of install (chromeos-install copies it
+// USB -> disk), OTA (payloads carry KERN + ROOT only) and powerwash
+// (clobber_state wipes STATE), and it carries neither a dm-verity hash tree nor
+// a signature -- so a variant is made by writing this file into an
+// already-built image, and the device then keeps that personality for good.
+// release/make-variant.sh in chromiumos-devenv does the writing.
+//
+// The partition is FAT, and the file sits at its root, so the person making a
+// USB stick can open it in Notepad on Windows. That audience drives every
+// parsing decision here:
+//
+//   * CRLF line endings and a UTF-8 BOM are normal, not corruption. Notepad
+//     writes both.
+//   * Keys and boolean values are case-insensitive, and surrounding quotes are
+//     stripped: REGION="VN" means the same as region=vn.
+//   * '#' and ';' both start a comment. Windows users expect ';' from .ini.
+//   * An unparseable line is skipped, and a value that fails validation falls
+//     back to that setting's default. One bad line must never take the machine
+//     with it -- a device that will not boot is far worse than one in the wrong
+//     language, and the person who made the typo is not the person holding the
+//     laptop.
+//   * Unknown keys are ignored, so an older build reads a newer file.
+//
+// Format, then, is just key=value:
+//
+//     # colorburst configuration
+//     region=vn
+//
+// There is deliberately no version key: settings are additive and unknown keys
+// are ignored, so old and new files are mutually readable. Adding one means
+// adding an accessor here, not a format migration.
+class ColorburstConfig {
+ public:
+  // Where the file lives on a booted device. The OEM partition is mounted
+  // read-only at /usr/share/oem by chromeos_startup (see
+  // init/startup/stateful_mount.cc).
+  static const char kDefaultPath[];
+
+  // Anything past this is not a configuration file. It only bounds how much of
+  // a corrupted partition is read before being rejected; the real file is a
+  // few short lines.
+  static const size_t kMaxFileSize;
+
+  ColorburstConfig();
+  ColorburstConfig(const ColorburstConfig&);
+  ColorburstConfig& operator=(const ColorburstConfig&);
+  ~ColorburstConfig();
+
+  // Reads and parses |path|. Never fails and never throws: an absent,
+  // unreadable or wholly malformed file yields an empty config, and an empty
+  // config means every accessor returns its default.
+  static ColorburstConfig Load(const base::FilePath& path);
+
+  // Parses |contents| directly. Load() is this plus a file read.
+  static ColorburstConfig ParseForTesting(std::string_view contents);
+
+  // The value for |key| exactly as written (minus quotes and whitespace), or
+  // nullopt when the key is absent. Prefer the typed accessors.
+  std::optional<std::string> GetRaw(std::string_view key) const;
+
+  // A short lowercase token: letters, digits, '.' and '-', at most 32 bytes.
+  // That covers every identifier the configuration deals in -- region codes,
+  // and whatever names come next -- and, importantly, excludes anything that
+  // could smuggle a second switch onto Chrome's command line. Returns
+  // |default_value| if the key is absent or the value is not such a token.
+  std::string GetToken(std::string_view key,
+                       std::string_view default_value) const;
+
+  // Accepts true/false, yes/no, on/off and 1/0. Returns |default_value| if the
+  // key is absent or the value is none of those. This is the seam the next
+  // settings hang off; nothing reads a boolean yet.
+  bool GetBool(std::string_view key, bool default_value) const;
+
+  // The device region: what Chrome turns into the OOBE language, the keyboard
+  // list and the timezone, via /usr/share/misc/cros-regions.json. Defaults to
+  // "us", which is also what an image with an untouched OEM partition gives.
+  std::string GetRegion() const;
+
+  // Number of key=value pairs that parsed. Zero is the normal state for a
+  // plain image.
+  size_t size() const { return values_.size(); }
+
+ private:
+  // Lowercased key -> value. std::less<> so string_view lookups do not
+  // allocate.
+  std::map<std::string, std::string, std::less<>> values_;
+};
+
+}  // namespace login_manager
+
+#endif  // LOGIN_MANAGER_COLORBURST_CONFIG_H_
diff --git a/login_manager/colorburst_config_test.cc b/login_manager/colorburst_config_test.cc
new file mode 100644
index 0000000000..97d54f1db7
--- /dev/null
+++ b/login_manager/colorburst_config_test.cc
@@ -0,0 +1,213 @@
+// Copyright 2026 The ChromiumOS Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "login_manager/colorburst_config.h"
+
+#include <string>
+#include <string_view>
+
+#include <base/check.h>
+#include <base/files/file_path.h>
+#include <base/files/file_util.h>
+#include <base/files/scoped_temp_dir.h>
+#include <gtest/gtest.h>
+
+namespace login_manager {
+
+namespace {
+
+// Parses |contents| as if it were the file on the OEM partition.
+ColorburstConfig Parse(std::string_view contents) {
+  return ColorburstConfig::ParseForTesting(contents);
+}
+
+std::string RegionOf(std::string_view contents) {
+  return Parse(contents).GetRegion();
+}
+
+}  // namespace
+
+// This one file decides how a device behaves, it is edited by hand on Windows,
+// and a wrong answer is silent -- the machine boots fine, just wrong. So the
+// parser is pinned down rather than trusted.
+class ColorburstConfigTest : public ::testing::Test {
+ public:
+  void SetUp() override { CHECK(dir_.CreateUniqueTempDir()); }
+
+  base::FilePath WriteConfig(std::string_view contents) {
+    const base::FilePath path = dir_.GetPath().Append("colorburst.txt");
+    CHECK(base::WriteFile(path, contents));
+    return path;
+  }
+
+  base::ScopedTempDir dir_;
+};
+
+// --- the empty cases: a plain image, and anything unreadable ----------------
+
+TEST_F(ColorburstConfigTest, MissingFileIsAllDefaults) {
+  // An image straight off the build, with an empty OEM partition.
+  const ColorburstConfig config =
+      ColorburstConfig::Load(dir_.GetPath().Append("nonexistent"));
+  EXPECT_EQ(0u, config.size());
+  EXPECT_EQ("us", config.GetRegion());
+  EXPECT_TRUE(config.GetBool("anything", true));
+  EXPECT_FALSE(config.GetBool("anything", false));
+}
+
+TEST_F(ColorburstConfigTest, LoadReadsAFileFromDisk) {
+  EXPECT_EQ("vn", ColorburstConfig::Load(WriteConfig("region=vn\n")).GetRegion());
+}
+
+TEST_F(ColorburstConfigTest, EmptyFileIsAllDefaults) {
+  EXPECT_EQ("us", RegionOf(""));
+  EXPECT_EQ(0u, Parse("").size());
+}
+
+TEST_F(ColorburstConfigTest, CommentsOnlyIsAllDefaults) {
+  EXPECT_EQ(0u, Parse("# nothing here\n; nor here\n").size());
+}
+
+// --- the shape of the file --------------------------------------------------
+
+TEST_F(ColorburstConfigTest, ReadsTheRegion) {
+  EXPECT_EQ("vn", RegionOf("region=vn\n"));
+}
+
+TEST_F(ColorburstConfigTest, IgnoresCommentsAndBlankLines) {
+  EXPECT_EQ("vn",
+            RegionOf("# colorburst configuration\n"
+                     "\n"
+                     "; semicolon comments too, as in .ini\n"
+                     "region=vn\n"));
+}
+
+TEST_F(ColorburstConfigTest, ToleratesNoTrailingNewline) {
+  EXPECT_EQ("vn", RegionOf("region=vn"));
+}
+
+TEST_F(ColorburstConfigTest, ToleratesWhitespaceAroundEverything) {
+  EXPECT_EQ("vn", RegionOf("   region   =   vn   \n"));
+}
+
+TEST_F(ColorburstConfigTest, KeepsTheFirstValueForAKey) {
+  // Appending to a file that already sets something must not silently win.
+  EXPECT_EQ("vn", RegionOf("region=vn\nregion=us\n"));
+}
+
+TEST_F(ColorburstConfigTest, UnknownKeysAreIgnoredButParsed) {
+  // Forward compatibility: an older build reads a newer file and still gets
+  // the settings it does understand.
+  const ColorburstConfig config =
+      Parse("region=vn\nsomething_from_the_future=42\n");
+  EXPECT_EQ("vn", config.GetRegion());
+  EXPECT_EQ(2u, config.size());
+}
+
+TEST_F(ColorburstConfigTest, JunkLinesAreSkippedNotFatal) {
+  // One bad line must not take the rest of the file with it.
+  EXPECT_EQ("vn", RegionOf("this line has no equals sign\nregion=vn\n"));
+  EXPECT_EQ("vn", RegionOf("=novalue\nregion=vn\n"));
+}
+
+// --- written by Notepad on Windows ------------------------------------------
+
+TEST_F(ColorburstConfigTest, HandlesCrlfLineEndings) {
+  EXPECT_EQ("vn", RegionOf("# comment\r\nregion=vn\r\n"));
+}
+
+TEST_F(ColorburstConfigTest, HandlesUtf8Bom) {
+  // Notepad's "UTF-8" encoding writes a BOM. Without stripping it the first key
+  // becomes "\xEF\xBB\xBFregion" and the file looks like it did not take.
+  EXPECT_EQ("vn", RegionOf("\xEF\xBB\xBF" "region=vn\n"));
+}
+
+TEST_F(ColorburstConfigTest, HandlesBomAndCrlfTogether) {
+  // Which is what you actually get from Notepad.
+  EXPECT_EQ("vn", RegionOf("\xEF\xBB\xBF" "# colorburst\r\nregion=vn\r\n"));
+}
+
+TEST_F(ColorburstConfigTest, KeysAndValuesAreCaseInsensitive) {
+  EXPECT_EQ("vn", RegionOf("REGION=VN\n"));
+  EXPECT_EQ("vn", RegionOf("Region=Vn\n"));
+}
+
+TEST_F(ColorburstConfigTest, StripsQuotes) {
+  EXPECT_EQ("vn", RegionOf("region=\"vn\"\n"));
+  EXPECT_EQ("vn", RegionOf("region='vn'\n"));
+  EXPECT_EQ("vn", RegionOf("region = \" vn \" \n"));
+}
+
+TEST_F(ColorburstConfigTest, UnbalancedQuotesAreNotStripped) {
+  // ...and therefore fail validation rather than becoming a surprise value.
+  EXPECT_EQ("us", RegionOf("region=\"vn\n"));
+}
+
+// --- validation -------------------------------------------------------------
+
+TEST_F(ColorburstConfigTest, AcceptsCompoundRegionCodes) {
+  // cros-regions.json really has entries shaped like these.
+  EXPECT_EQ("latam-es-419", RegionOf("region=latam-es-419\n"));
+  EXPECT_EQ("br.abnt", RegionOf("region=br.abnt\n"));
+}
+
+TEST_F(ColorburstConfigTest, EmptyValueFallsBack) {
+  EXPECT_EQ("us", RegionOf("region=\n"));
+  EXPECT_EQ("us", RegionOf("region=   \n"));
+}
+
+TEST_F(ColorburstConfigTest, RejectsSmuggledSwitches) {
+  // These strings become Chrome command-line arguments, and the OEM partition
+  // is writable by anyone holding the disk -- on Windows, now, with Notepad.
+  EXPECT_EQ("us", RegionOf("region=vn --disable-gaia-services\n"));
+  EXPECT_EQ("us", RegionOf("region=vn;rm -rf /\n"));
+  EXPECT_EQ("us", RegionOf("region=../../etc/passwd\n"));
+  EXPECT_EQ("us", RegionOf("region=vn\\n--foo\n"));
+}
+
+TEST_F(ColorburstConfigTest, RejectsAnOverlongValue) {
+  EXPECT_EQ("us", RegionOf("region=" + std::string(33, 'a') + "\n"));
+  EXPECT_EQ(std::string(32, 'a'),
+            RegionOf("region=" + std::string(32, 'a') + "\n"));
+}
+
+TEST_F(ColorburstConfigTest, RejectsBinaryGarbage) {
+  // A corrupted or half-written OEM partition.
+  EXPECT_EQ("us", RegionOf(std::string("region=\x01\x02\xff\n", 11)));
+}
+
+// --- booleans: the seam the next settings hang off ---------------------------
+
+TEST_F(ColorburstConfigTest, ParsesEveryReasonableSpellingOfYes) {
+  for (const char* yes : {"true", "yes", "on", "1", "TRUE", "Yes", "ON"}) {
+    const ColorburstConfig config = Parse(std::string("flag=") + yes);
+    EXPECT_TRUE(config.GetBool("flag", false)) << yes;
+  }
+}
+
+TEST_F(ColorburstConfigTest, ParsesEveryReasonableSpellingOfNo) {
+  for (const char* no : {"false", "no", "off", "0", "FALSE", "No", "OFF"}) {
+    const ColorburstConfig config = Parse(std::string("flag=") + no);
+    EXPECT_FALSE(config.GetBool("flag", true)) << no;
+  }
+}
+
+TEST_F(ColorburstConfigTest, BoolFallsBackBothWays) {
+  // A value nobody can interpret must not silently mean "off" -- the caller's
+  // default is the safe answer, whichever way it points.
+  EXPECT_TRUE(Parse("flag=maybe").GetBool("flag", true));
+  EXPECT_FALSE(Parse("flag=maybe").GetBool("flag", false));
+  EXPECT_TRUE(Parse("other=yes").GetBool("flag", true));
+}
+
+// --- raw access -------------------------------------------------------------
+
+TEST_F(ColorburstConfigTest, GetRawReturnsTheValueAsWritten) {
+  const ColorburstConfig config = Parse("Region= \"Vn\" \n");
+  EXPECT_EQ("Vn", config.GetRaw("region"));
+  EXPECT_EQ("Vn", config.GetRaw("REGION"));
+  EXPECT_EQ(std::nullopt, config.GetRaw("absent"));
+}
+
+}  // namespace login_manager
