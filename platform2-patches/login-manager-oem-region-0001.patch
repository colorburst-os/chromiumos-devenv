 };
 
+// NOTE(colorburst fork): the colorburst variant marker. This one file decides
+// which language a USB image boots in, and a wrong answer is silent -- the
+// machine comes up fine, just in the wrong language -- so the parser is pinned
+// down here rather than trusted.
+class ColorburstRegionTest : public ::testing::Test {
+ public:
+  void SetUp() override { CHECK(dir_.CreateUniqueTempDir()); }
+
+  // Writes |contents| to a marker file and returns the region parsed from it.
+  std::string RegionFor(std::string_view contents) {
+    const base::FilePath path = dir_.GetPath().Append("variant");
+    CHECK(base::WriteFile(path, contents));
+    return GetColorburstRegion(path);
+  }
+
+  base::ScopedTempDir dir_;
+};
+
+TEST_F(ColorburstRegionTest, MissingFileIsEnglish) {
+  // An image straight off the build, with an empty OEM partition.
+  EXPECT_EQ("us", GetColorburstRegion(dir_.GetPath().Append("nonexistent")));
+}
+
+TEST_F(ColorburstRegionTest, ReadsTheRegion) {
+  EXPECT_EQ("vn", RegionFor("region=vn\n"));
+}
+
+TEST_F(ColorburstRegionTest, IgnoresCommentsAndBlankLines) {
+  // The marker release/make-variant.sh actually writes.
+  EXPECT_EQ("vn",
+            RegionFor("# colorburst variant marker -- read at boot.\n"
+                      "# Survives install, OTA and powerwash.\n"
+                      "\n"
+                      "region=vn\n"));
+}
+
+TEST_F(ColorburstRegionTest, ToleratesNoTrailingNewline) {
+  EXPECT_EQ("vn", RegionFor("region=vn"));
+}
+
+TEST_F(ColorburstRegionTest, AcceptsCompoundRegionCodes) {
+  // cros-regions.json really has entries shaped like these; they must not be
+  // mistaken for malformed input.
+  EXPECT_EQ("latam-es-419", RegionFor("region=latam-es-419\n"));
+  EXPECT_EQ("br.abnt", RegionFor("region=br.abnt\n"));
+}
+
+TEST_F(ColorburstRegionTest, KeepsTheFirstRegionLine) {
+  EXPECT_EQ("vn", RegionFor("region=vn\nregion=us\n"));
+}
+
+TEST_F(ColorburstRegionTest, EmptyValueIsEnglish) {
+  EXPECT_EQ("us", RegionFor("region=\n"));
+}
+
+TEST_F(ColorburstRegionTest, EmptyFileIsEnglish) {
+  EXPECT_EQ("us", RegionFor(""));
+}
+
+TEST_F(ColorburstRegionTest, UnrelatedKeysAreIgnored) {
+  EXPECT_EQ("us", RegionFor("variant=vi\nnotes=hello\n"));
+}
+
+TEST_F(ColorburstRegionTest, RejectsSmuggledSwitches) {
+  // This string becomes a Chrome command-line argument, and the OEM partition
+  // is writable by anyone holding the disk. Falling back to the default beats
+  // passing it along.
+  EXPECT_EQ("us", RegionFor("region=vn --disable-gaia-services\n"));
+  EXPECT_EQ("us", RegionFor("region=vn;rm -rf /\n"));
+  EXPECT_EQ("us", RegionFor("region=../../etc/passwd\n"));
+  EXPECT_EQ("us", RegionFor("region=VN\n"));
+}
+
+TEST_F(ColorburstRegionTest, RejectsAnOverlongRegion) {
+  EXPECT_EQ("us", RegionFor("region=" + std::string(33, 'a') + "\n"));
+  EXPECT_EQ(std::string(32, 'a'),
+            RegionFor("region=" + std::string(32, 'a') + "\n"));
+}
+
+TEST_F(ColorburstRegionTest, RejectsBinaryGarbage) {
+  // A corrupted or half-written OEM partition.
+  EXPECT_EQ("us", RegionFor(std::string("region=\x01\x02\xff\n", 11)));
+}
