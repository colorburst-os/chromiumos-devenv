From e983eb506a873596da467228619d528db5347df7 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?L=C6=B0u=20Oa=20Oa?=
 <212658678+luuoaoa@users.noreply.github.com>
Date: Tue, 18 Aug 2026 02:28:42 -0700
Subject: [PATCH] update_engine: send colorburst's per-installation device id

Our update server needs to tell installations apart to stage a release
(canary first, then a percentage wave) and to count the fleet honestly.
hardware_class cannot do it: it identifies a firmware-declared model, and
on reven-based hardware it is the literal string "unknown".

So the Omaha app tag gains colorburst_device_id, read once from
/var/lib/colorburst/device-id. That file holds a random UUID minted by the
colorburst-device-id upstart job -- not derived from the DMI serial, a MAC
or the flex_id chain, so it identifies an installation and not a machine,
and a powerwash mints a new one. The job skips removable (USB/live) and
recovery boots, so the file is simply absent there and the attribute is
omitted: someone evaluating colorburst from a stick is not a device in the
fleet and must not carry an id onto other machines.

Verified on a VM: the attribute reaches the wire with no SELinux denial
(the file inherits cros_var_lib, which update_engine can read).

Change-Id: I2ae3666e27c25c8a869bfe4348d001b438c8e99a
---
 update_engine/common/constants.cc               |  3 +++
 update_engine/common/constants.h                |  5 +++++
 update_engine/cros/omaha_request_builder_xml.cc | 12 ++++++++++++
 update_engine/cros/omaha_request_params.cc      | 14 ++++++++++++++
 update_engine/cros/omaha_request_params.h       | 14 ++++++++++++++
 5 files changed, 48 insertions(+)

diff --git a/update_engine/common/constants.cc b/update_engine/common/constants.cc
index 27df82a0ee..ce5ad8cce5 100644
--- a/update_engine/common/constants.cc
+++ b/update_engine/common/constants.cc
@@ -18,6 +18,9 @@ const char kPrefsSubDirectory[] = "prefs";
 
 const char kStatefulPartition[] = "/mnt/stateful_partition";
 
+// NOTE(colorburst fork): see the declaration in constants.h.
+const char kColorburstDeviceIdPath[] = "/var/lib/colorburst/device-id";
+
 const char kPostinstallDefaultScript[] = "postinst";
 
 // Constants defining keys for the persisted state of update engine.
diff --git a/update_engine/common/constants.h b/update_engine/common/constants.h
index 5302af9180..67298a1157 100644
--- a/update_engine/common/constants.h
+++ b/update_engine/common/constants.h
@@ -32,6 +32,11 @@ extern const char kPostinstallDefaultScript[];
 // Path to the stateful partition on the root filesystem.
 extern const char kStatefulPartition[];
 
+// NOTE(colorburst fork): file holding this installation's opaque device id,
+// written once by the colorburst-device-id upstart job. Absent on removable
+// (USB/live) and recovery boots, in which case no id is sent.
+extern const char kColorburstDeviceIdPath[];
+
 // Constants related to preferences.
 extern const char kPrefsAllowRepeatedUpdates[];
 extern const char kPrefsAttemptInProgress[];
diff --git a/update_engine/cros/omaha_request_builder_xml.cc b/update_engine/cros/omaha_request_builder_xml.cc
index 27f7f6c9e8..9729e620c3 100644
--- a/update_engine/cros/omaha_request_builder_xml.cc
+++ b/update_engine/cros/omaha_request_builder_xml.cc
@@ -395,6 +395,17 @@ string OmahaRequestBuilderXml::GetApp(const OmahaAppData& app_data) const {
     }
   }
 
+  // NOTE(colorburst fork): our own update server distinguishes installations
+  // by this id (staged rollouts, canary targeting, honest device counts).
+  // Empty -- and therefore omitted -- on USB/live and recovery boots, which
+  // must not be counted as devices. See kColorburstDeviceIdPath.
+  string colorburst_device_id_arg;
+  if (!params->colorburst_device_id().empty()) {
+    colorburst_device_id_arg =
+        "colorburst_device_id=\"" +
+        XmlEncodeWithDefault(params->colorburst_device_id()) + "\" ";
+  }
+
   // clang-format off
   string app_xml = "    <app "
       "appid=\"" + XmlEncodeWithDefault(app_data.id) + "\" " +
@@ -404,6 +415,7 @@ string OmahaRequestBuilderXml::GetApp(const OmahaAppData& app_data) const {
       product_components_args +
       fingerprint_arg +
       buildtype_arg +
+      colorburst_device_id_arg +
       "board=\"" + XmlEncodeWithDefault(params->os_board()) + "\" " +
       "hardware_class=\"" + XmlEncodeWithDefault(params->hwid()) + "\" " +
       "delta_okay=\"" + delta_okay_str + "\" " +
diff --git a/update_engine/cros/omaha_request_params.cc b/update_engine/cros/omaha_request_params.cc
index aefd135362..0127bec7e0 100644
--- a/update_engine/cros/omaha_request_params.cc
+++ b/update_engine/cros/omaha_request_params.cc
@@ -98,6 +98,20 @@ bool OmahaRequestParams::Init(const string& app_version,
   const auto* hardware = SystemState::Get()->hardware();
   managed_device_in_oobe_ = hardware->IsManagedDeviceInOobe();
   hwid_ = hardware->GetHardwareClass();
+
+  // NOTE(colorburst fork): the per-installation id, if this installation has
+  // one. The file is created once by the colorburst-device-id upstart job,
+  // which skips removable (USB/live) and recovery boots, so "no file" is the
+  // normal and expected state there and simply means we send no id.
+  colorburst_device_id_.clear();
+  {
+    std::string id;
+    if (base::ReadFileToString(base::FilePath(root_ + kColorburstDeviceIdPath),
+                               &id)) {
+      colorburst_device_id_ = std::string(base::TrimWhitespaceASCII(
+          id, base::TrimPositions::TRIM_ALL));
+    }
+  }
   if (hardware->IsRunningFromMiniOs()) {
     delta_okay_ = false;
     image_props_.version = kNoVersion;
diff --git a/update_engine/cros/omaha_request_params.h b/update_engine/cros/omaha_request_params.h
index 45b2c519f2..17a2322e4e 100644
--- a/update_engine/cros/omaha_request_params.h
+++ b/update_engine/cros/omaha_request_params.h
@@ -98,6 +98,18 @@ class OmahaRequestParams {
   }
   inline std::string hwid() const { return hwid_; }
 
+  // NOTE(colorburst fork): an opaque per-installation identifier, read once
+  // from |kColorburstDeviceIdPath|. Empty when the file is absent, which is
+  // the case on USB/live and recovery boots -- see the colorburst-device-id
+  // upstart job, which is what creates it and deliberately skips removable
+  // boots. Sent to our own update server only; see GetAppXml().
+  inline std::string colorburst_device_id() const {
+    return colorburst_device_id_;
+  }
+  inline void set_colorburst_device_id(const std::string& id) {
+    colorburst_device_id_ = id;
+  }
+
   inline void set_app_version(const std::string& version) {
     image_props_.version = version;
   }
@@ -409,6 +421,8 @@ class OmahaRequestParams {
   std::string release_lts_tag_;
 
   std::string hwid_;          // Hardware Qualification ID of the client
+  // NOTE(colorburst fork): see colorburst_device_id().
+  std::string colorburst_device_id_;
   bool delta_okay_ = true;    // If this client can accept a delta
   bool interactive_ = false;  // Whether this is a user-initiated update check
 
-- 
